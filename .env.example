# ==============================================================================
# Savora Monorepo Environment Template
# Copy this file to `.env` (`cp .env.example .env`) and fill in real values.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- Database (Supabase PostgreSQL Direct Connection) -------------------------
# Percent-encode any special characters in POSTGRES_PASSWORD (e.g., @ -> %40)
POSTGRES_HOST=db.<YOUR-SUPABASE-PROJECT-REF>.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR-DB-PASSWORD>

# FastAPI + SQLAlchemy 2 (asyncpg) & Alembic
DATABASE_URL=postgresql+asyncpg://postgres:<YOUR-DB-PASSWORD>@db.<YOUR-SUPABASE-PROJECT-REF>.supabase.co:5432/postgres

# --- Backend Auth & Security --------------------------------------------------
# development | test | production. In production the backend refuses to start with
# the development JWT secret or one shorter than 32 characters.
APP_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE-ME-GENERATE-WITH-OPENSSL-RAND-HEX-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI System (Qwen craving NLU) ---------------------------------------------
# QWEN_PROVIDER: ollama | openai (hosted OpenAI-compatible, needs QWEN_API_KEY) | none
# If Ollama is not running, the deterministic template parser is used and labelled.
#
# Option A: Local Ollama (default, 0 keys needed)
#   ollama pull qwen3:0.6b        (upgrade option: qwen2.5:1.5b)
QWEN_PROVIDER=ollama
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL_NAME=qwen3:0.6b
QWEN_TIMEOUT_S=8
QWEN_API_KEY=
#
# Option B: Hosted OpenRouter Free Tier (0 local RAM needed)
#   QWEN_PROVIDER=openai
#   QWEN_BASE_URL=https://openrouter.ai/api/v1
#   QWEN_MODEL_NAME=qwen/qwen-2.5-7b-instruct:free
#   QWEN_TIMEOUT_S=10
#   QWEN_API_KEY=sk-or-v1-...

# Member 2's compact B1 swap proof (ADR 0007): required | record | off.
# "required" saves a swap only when it is independently verified (adds a few minutes).
SWAP_PROOF_MODE=required

# --- Password reset email ---------------------------------------------------
# The reset link is emailed through SMTP when SMTP_HOST is set. Without it, outside
# production, the link is written to the backend log; in production nothing is sent.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Savora <no-reply@example.com>
SMTP_STARTTLS=true

# --- Frontend / API Proxy -----------------------------------------------------
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
